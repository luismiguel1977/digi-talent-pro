{
  "name": "digi-talent-pro",
  "version": "1.3.7",
  "description": "Digi Talent Pro - Evaluación Comercial D2D Mobile App",
  "main": "src/js/app.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android": "npx cap run android",
    "android:build": "npx cap build android",
    "ios": "npx cap run ios",
    "ios:build": "npx cap build ios",
    "capacitor:sync": "npx cap sync",
    "capacitor:add:android": "npx cap add android",
    "capacitor:add:ios": "npx cap add ios",
    "generate-apk": "cd android && ./gradlew assembleRelease",
    "generate-aab": "cd android && ./gradlew bundleRelease",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "keywords": [
    "digi",
    "talent",
    "evaluation",
    "d2d",
    "sales",
    "mobile",
    "capacitor",
    "android"
  ],
  "author": "Digi Talent Pro Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/app": "^5.0.7",
    "@capacitor/camera": "^5.0.9",
    "@capacitor/core": "^5.7.0",
    "@capacitor/device": "^5.0.7",
    "@capacitor/filesystem": "^5.2.1",
    "@capacitor/haptics": "^5.0.7",
    "@capacitor/keyboard": "^5.0.8",
    "@capacitor/preferences": "^5.0.7",
    "@capacitor/share": "^5.0.7",
    "@capacitor/splash-screen": "^5.0.7",
    "@capacitor/status-bar": "^5.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "gh-pages": "^6.3.0",
    "jimp": "^0.16.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.4"
  }
}
